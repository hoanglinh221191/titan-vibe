integrator = md
dt = 0.001
tinit = 0
init-step = 0
nsteps = 200
simulation-part = 1
continuation = no
gen-vel = no
constraints = none
tcoupl = no
pcoupl = no
comm-mode = Linear
nstcomm = 10
cutoff-scheme = Verlet
nstlist = 10
rlist = 1.0
coulombtype = Cut-off
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
pbc = xyz
nstcalcenergy = 1
nstenergy = 1
nstlog = 10
nstxout = 1
nstvout = 1
nstfout = 1
nstxout-compressed = 1
compressed-x-precision = 1000000
pull = yes
pull-ngroups = 2
pull-ncoords = 1
pull-group1-name = REF
pull-group2-name = LIG
pull-coord1-type = umbrella
pull-coord1-geometry = direction
pull-coord1-groups = 1 2
pull-coord1-dim = Y Y Y
pull-coord1-vec = 1 0 0
pull-coord1-start = no
pull-coord1-init = 1.0
pull-coord1-rate = 0.001
pull-coord1-k = 100.0
pull-nstxout = 1
pull-nstfout = 1
pull-print-ref-value = yes
pull-print-com = yes
pull-print-components = yes
pull-xout-average = no
pull-fout-average = no
